{
  "id": "./",
  "name": "WerfPlan – 3D bouwplaatsinrichting",
  "short_name": "WerfPlan",
  "description": "Plan je bouwplaatsinrichting in 3D en lever een plattegrond op schaal.",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b2547",
  "theme_color": "#0b2547",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-werfplan": [".werfplan"] },
      "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
